/var/log/__APP__/*.log {
    daily
    missingok
    rotate 30
    compress
    delaycompress
    notifempty
    create 0640 __APP__ www-data
    sharedscripts
    postrotate
        [ -s /var/run/php/php8.3-fpm-__APP__.sock ] && systemctl reload php8.3-fpm.service > /dev/null 2>&1 || true
    endscript
}
